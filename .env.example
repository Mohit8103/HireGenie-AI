# -----------------------------------------------------------------------------
# HireGenie AI - Environment Variables Template
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to exactly `.env`
# 2. Fill in the actual values for each variable below
# 3. NEVER commit your actual `.env` file to version control!
# -----------------------------------------------------------------------------

# Flask Secret Key (used for securely signing session cookies)
# Generate a strong key in python using: `import secrets; print(secrets.token_hex(32))`
SECRET_KEY=your_super_secret_key_here

# Database Configuration (Defaults to local SQLite database in instance folder)
# Format for PostgreSQL: postgresql://username:password@localhost/dbname
DATABASE_URI=sqlite:///recruitment.db

# Google Gemini API Key (Required for AI Resume parsing and scoring)
# Get this from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
